[Unit]
Description=KIMBA — Flask/Gunicorn
After=network.target postgresql.service

[Service]
User=kimba
Group=kimba
WorkingDirectory=/var/www/kimba
EnvironmentFile=/var/www/kimba/.env
ExecStart=/var/www/kimba/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8007 --timeout 120 --access-logfile /var/log/kimba/access.log --error-logfile /var/log/kimba/error.log kimba:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
