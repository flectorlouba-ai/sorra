# Copier ce fichier en « .env » et remplir les valeurs. Ne jamais commiter le .env.

# development (par défaut, SQLite local) | production (PostgreSQL)
KIMBA_ENV=development
FLASK_APP=kimba

# Clé secrète des sessions : longue et aléatoire en production.
# Pour en générer une : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a-remplacer

# Base de données. Sans cette ligne : fichier SQLite kimba_dev.db dans le dossier du projet.
# Production : DATABASE_URL=postgresql+psycopg2://kimba:MOT_DE_PASSE@127.0.0.1:5432/kimba
#DATABASE_URL=

# Port de l'application (lancement par « python kimba.py »)
PORT=5020

# 1 seulement si l'application est servie en HTTPS
COOKIE_SECURE=0
