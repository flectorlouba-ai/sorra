# Copier ce fichier en « .env » et remplir les valeurs. Ne jamais commiter le .env.

# development (par défaut, SQLite local) | production (PostgreSQL)
YL2_ENV=development
FLASK_APP=performyl2

# Clé secrète des sessions : longue et aléatoire en production.
# Pour en générer une : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a-remplacer

# Base de données. Sans cette ligne : fichier SQLite performyl2_dev.db dans le dossier du projet.
# Production : DATABASE_URL=postgresql+psycopg2://performyl2:MOT_DE_PASSE@127.0.0.1:5432/performyl2
#DATABASE_URL=

# Port de l'application (lancement par « python performyl2.py »)
PORT=5020

# 1 seulement si l'application est servie en HTTPS
COOKIE_SECURE=0

# 1 si l'application est derrière nginx (production) : le journal note alors la
# vraie adresse du visiteur au lieu de 127.0.0.1
DERRIERE_PROXY=0
